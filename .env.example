# Identifiants des outils tiers — copiez ce fichier vers .env.local
# et renseignez vos propres identifiants. Toute variable absente
# désactive simplement l'outil correspondant.
# NB : avec l'export statique, ces valeurs sont intégrées au moment du build.

# Google Tag Manager (gère GA4, Conversion Linker, remarketing, etc.)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 (si utilisé sans GTM)
NEXT_PUBLIC_GA_ID=

# OneSignal — notifications push (App ID)
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Sentry — suivi d'erreurs (URL du loader, ex : https://js.sentry-cdn.com/xxxx.min.js)
NEXT_PUBLIC_SENTRY_LOADER_URL=
